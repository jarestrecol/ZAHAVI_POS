# Configuracion publica del cliente Supabase. Copiar a .env.local y completar.
# Nunca incluir SUPABASE_SERVICE_ROLE_KEY ni claves de base de datos en este proyecto.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Solo para funciones de servidor que dan de alta, desactivan o restablecen PIN.
# No usar el prefijo VITE_; nunca enviar esta clave al navegador ni versionarla.
SUPABASE_SECRET_KEY=

# Dependencias: ninguna en tiempo de ejecucion. La unica de desarrollo es el
# navegador de pruebas, y su version SI se versiona (`package-lock.json`): si
# la integracion continua instala una distinta, las pruebas dejan de decir lo
# mismo aqui que alli.
node_modules/

# Resultados de las pruebas de navegador: se regeneran en cada pasada.
test-results/
playwright-report/
.playwright-mcp/
test-results-*/
test-results-*.json

# Datos reales de la panaderia. Nunca deben entrar al repositorio publico.
RESPALDO-PRIVADO-*.json
*.xlsx
*.xls
uploads/
data/recipes.private.json


# Sistema y editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Entorno
.env
.env.*
!.env.example
*.log

# Resultado del build. Se regenera con `npm run build`; lo que se versiona es la
# fuente. Vercel lo construye de nuevo en cada despliegue.
dist/

# Permisos locales de la sesión de Claude Code (no se comparten)
.claude/settings.local.json

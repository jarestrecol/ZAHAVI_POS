{
  "name": "zahavi-recetario",
  "version": "2.0.0",
  "private": true,
  "description": "Recetario de produccion para panaderia, reposteria y cafe. Sin dependencias en tiempo de ejecucion; artefacto estatico opcional.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/copiar-estaticos.mjs && node scripts/generar-shell.mjs",
    "verificar": "node scripts/verificar.mjs",
    "verificar-sql": "node scripts/verificar-sql.mjs",
    "probar-sql": "node scripts/probar-sql.mjs",
    "test:api": "node scripts/test-api.mjs",
    "test:datos": "node scripts/test-datos.mjs",
    "test:publicacion": "node scripts/test-publicacion.mjs",
    "test:almacen": "node scripts/test-almacen.mjs",
    "test:produccion": "node scripts/test-produccion.mjs",
    "test:informes": "node scripts/test-informes.mjs",
    "test:calendario": "node scripts/test-calendario.mjs",
    "test:costeo": "node scripts/test-casos-costeo.mjs",
    "test:bi": "node scripts/test-bi.mjs",
    "test:bi-ejemplo": "node scripts/test-bi-ejemplo.mjs",
    "test:servidor": "node scripts/test-servidor.mjs",
    "qa": "playwright test",
    "qa:ver": "playwright test --ui",
    "servidor": "node scripts/servidor.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "vite": "8.3.0"
  }
}
